{
  "info": {
    "_postman_id": "d0e7f8a5-9a7f-4efb-8d37-123456789abc",
    "name": "Article Service",
    "description": "Collection based on the current router. There is no individual GET /articles/:id endpoint.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "article_id", "value": "" },
    { "key": "request_id", "value": "" },
    { "key": "next_cursor", "value": "" },
    { "key": "page_1_ids", "value": "[]" },
    { "key": "created_body", "value": "" },
    { "key": "created_version", "value": "" },
    { "key": "created_at", "value": "" },
    { "key": "created_author_id", "value": "" }
  ],
  "item": [
    {
      "name": "Articles",
      "item": [
        {
          "name": "Create Article",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author_id\": 1,\n  \"title\": \"Membangun Golang API yang Reliable\",\n  \"body\": \"Transactional outbox menjaga consistency saat Go API menulis ke PostgreSQL, Elasticsearch, dan Redis.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/articles" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });",
                "const json = pm.response.json();",
                "pm.test(\"created article has the complete response shape\", function () {",
                "    pm.expect(json.data).to.include.all.keys(\"id\", \"author_id\", \"title\", \"body\", \"version\", \"created_at\", \"updated_at\");",
                "    pm.expect(json.data.id).to.be.a(\"number\");",
                "    pm.expect(json.data.title).to.include(\"Golang\");",
                "    pm.expect(json.data.body).to.include(\"Transactional outbox\");",
                "});",
                "pm.collectionVariables.set(\"article_id\", String(json.data.id));",
                "pm.collectionVariables.set(\"created_author_id\", String(json.data.author_id));",
                "pm.collectionVariables.set(\"created_body\", json.data.body);",
                "pm.collectionVariables.set(\"created_version\", String(json.data.version));",
                "pm.collectionVariables.set(\"created_at\", json.data.created_at);",
                "pm.collectionVariables.set(\"request_id\", pm.response.headers.get(\"X-Request-ID\") || \"\");",
                "pm.test(\"X-Request-ID is returned\", function () { pm.expect(pm.response.headers.get(\"X-Request-ID\")).to.be.a(\"string\").and.not.empty; });"
              ]
            }
          }]
        },
        {
          "name": "Create Article - Invalid Input",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"author_id\": 0,\n  \"title\": \"\",\n  \"body\": \"\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/articles" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status is 400\", function () { pm.response.to.have.status(400); });",
                "const json = pm.response.json();",
                "pm.test(\"validation error has the documented envelope\", function () { pm.expect(json.error.code).to.eql(\"VALIDATION_ERROR\"); pm.expect(json.error.message).to.be.a(\"string\"); });"
              ]
            }
          }]
        },
        {
          "name": "List Articles - First Page",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/articles?limit=2" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "pm.test(\"listing contains article and pagination fields\", function () {",
                "    pm.expect(json.data).to.be.an(\"array\");",
                "    pm.expect(json.pagination).to.include.all.keys(\"limit\", \"next_cursor\", \"has_more\");",
                "    json.data.forEach(function (a) { pm.expect(a).to.include.all.keys(\"id\", \"author_id\", \"title\", \"body\", \"version\", \"created_at\", \"updated_at\"); });",
                "});",
                "pm.test(\"articles are sorted newest first\", function () { for (let i = 1; i < json.data.length; i++) pm.expect(Date.parse(json.data[i - 1].created_at)).to.be.at.least(Date.parse(json.data[i].created_at)); });",
                "pm.collectionVariables.set(\"page_1_ids\", JSON.stringify(json.data.map(function (a) { return a.id; })));",
                "if (json.pagination.next_cursor) pm.collectionVariables.set(\"next_cursor\", json.pagination.next_cursor);"
              ]
            }
          }]
        },
        {
          "name": "List Articles - Next Page",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/articles?limit=2&cursor={{next_cursor}}" }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": { "type": "text/javascript", "exec": ["if (!pm.collectionVariables.get(\"next_cursor\")) pm.execution.skipRequest();"] }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const page1 = JSON.parse(pm.collectionVariables.get(\"page_1_ids\") || \"[]\");",
                  "const ids = json.data.map(function (a) { return a.id; });",
                  "pm.test(\"pagination has no duplicates and preserves newest-first order\", function () {",
                  "    pm.expect(new Set(ids).size).to.eql(ids.length);",
                  "    ids.forEach(function (id) { pm.expect(page1).to.not.include(id); });",
                  "    for (let i = 1; i < json.data.length; i++) pm.expect(Date.parse(json.data[i - 1].created_at)).to.be.at.least(Date.parse(json.data[i].created_at));",
                  "});",
                  "pm.expect(json.pagination).to.include.all.keys(\"limit\", \"next_cursor\", \"has_more\");",
                  "if (json.pagination.next_cursor) pm.collectionVariables.set(\"next_cursor\", json.pagination.next_cursor);"
                ]
              }
            }
          ]
        },
        {
          "name": "Search Articles - Keyword",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/articles?query=Golang&limit=10" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "pm.test(\"keyword search matches title or body and returns pagination\", function () {",
                "    pm.expect(json.data).to.be.an(\"array\");",
                "    json.data.forEach(function (a) { pm.expect((a.title + \" \" + a.body).toLowerCase()).to.include(\"golang\"); });",
                "    const created = json.data.find(function (a) { return String(a.id) === pm.collectionVariables.get(\"article_id\"); });",
                "    if (created) { pm.expect(created.title).to.include(\"Membangun\"); pm.expect(created.title).to.include(\"Reliable\"); }",
                "    pm.expect(json.pagination).to.include.all.keys(\"limit\", \"next_cursor\", \"has_more\");",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Filter by Author",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/articles?author=Budi%20Santoso&limit=10" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "pm.test(\"author filter returns article contents and valid IDs\", function () {",
                "    pm.expect(json.data).to.be.an(\"array\").and.not.empty;",
                "    json.data.forEach(function (a) { pm.expect(a.author_id).to.be.a(\"number\").and.above(0); pm.expect(a.title).to.be.a(\"string\"); pm.expect(a.body).to.be.a(\"string\"); });",
                "    pm.expect(json.pagination).to.include.all.keys(\"limit\", \"next_cursor\", \"has_more\");",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Combined Search and Author",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/articles?query=transactional&author=Budi%20Santoso&limit=10" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "pm.test(\"combined filter matches keyword in body\", function () {",
                "    pm.expect(json.data).to.be.an(\"array\");",
                "    json.data.forEach(function (a) { pm.expect((a.title + \" \" + a.body).toLowerCase()).to.include(\"transactional\"); });",
                "    pm.expect(json.pagination).to.include.all.keys(\"limit\", \"next_cursor\", \"has_more\");",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Filter by Author - No Matches",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/articles?author=Author%20Yang%20Tidak%20Ada&limit=10" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"unknown author returns an empty listing\", function () {",
                "    pm.response.to.have.status(200);",
                "    const json = pm.response.json();",
                "    pm.expect(json.data).to.be.an(\"array\").and.empty;",
                "    pm.expect(json.pagination.has_more).to.eql(false);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Update Article",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Membangun Golang API yang Reliable - Updated\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/articles/{{article_id}}" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                "const json = pm.response.json();",
                "const article = json.data;",
                "pm.test(\"PATCH is partial and increments version\", function () {",
                "    pm.expect(article.id).to.eql(Number(pm.collectionVariables.get(\"article_id\")));",
                "    pm.expect(article.title).to.include(\"Updated\");",
                "    pm.expect(article.body).to.eql(pm.collectionVariables.get(\"created_body\"));",
                "    pm.expect(article.version).to.eql(Number(pm.collectionVariables.get(\"created_version\")) + 1);",
                "    pm.expect(article.created_at).to.eql(pm.collectionVariables.get(\"created_at\"));",
                "    pm.expect(Date.parse(article.updated_at)).to.be.at.least(Date.parse(article.created_at));",
                "});"
              ]
            }
          }]
        },
        {
          "name": "Update Article - Not Found",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Artikel yang tidak ada\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/articles/9223372036854775807" }
          },
          "response": [],
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"status is 404\", function () { pm.response.to.have.status(404); });",
                "pm.test(\"not found error envelope\", function () { pm.expect(pm.response.json().error.code).to.eql(\"NOT_FOUND\"); });"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "Health & Readiness",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/health" } },
          "response": [],
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"health response is ok\", function () { pm.expect(pm.response.json()).to.eql({ status: \"ok\" }); });"
            ] }
          }]
        },
        {
          "name": "Readiness Check",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/ready" } },
          "response": [],
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test(\"status is 200 or 503\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 503]); });",
              "pm.test(\"readiness has status field\", function () { pm.expect(pm.response.json().status).to.be.oneOf([\"ok\", \"unavailable\"]); });"
            ] }
          }]
        }
      ]
    }
  ]
}
